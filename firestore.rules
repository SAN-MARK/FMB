rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "iamheresanjeev@gmail.com" || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == "iamheresanjeev@gmail.com");
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId) || isAdmin();
    }

    match /found_items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        (resource.data.reporter_id == request.auth.uid || 
         resource.data.finderId == request.auth.uid || 
         isAdmin());
    }

    match /claims/{claimId} {
      allow read: if isAuthenticated() && 
        (resource.data.claimant_id == request.auth.uid || 
         resource.data.ownerId == request.auth.uid || 
         isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (resource.data.claimant_id == request.auth.uid || 
         resource.data.ownerId == request.auth.uid || 
         isAdmin());
      allow delete: if isAdmin();
    }

    match /hubs/{hubId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && 
        (resource.data.finder_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /admin_audit_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // immutable audit log
    }

    match /messages/{messageId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}

